# =========================================================================
# CONFIGURATION TEMPLATE FOR COMMERCIAL PRODUCTION - MANGASCRIBE AI
# =========================================================================
# Copy this file to `.env` or `.env.local` and customize for your servers on
# CMC Cloud and domains managed under Cloudflare.

# -------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (CMC Cloud Private VPC Database)
# -------------------------------------------------------------------------
# Replace with your actual PostgreSQL connection string from your dedicated Database VPS.
# Since it is in the same VPC network, use the Private IP of the Database VPS for maximum speed & security.
# If this is omitted, the app will automatically fall back to local JSON file DB.
DATABASE_URL="postgresql://db_user:db_password@<private-ip-of-db-vps>:5432/manga2novel"

# -------------------------------------------------------------------------
# 2. DATA ENCRYPTION SECURITY (AES-256-GCM)
# -------------------------------------------------------------------------
# A random 32-character string used to encrypt users' API keys and S3 credentials in the DB.
# IMPORTANT: Keep this private and do not change it once running in production,
# otherwise all existing encrypted keys in the DB will become unreadable!
ENCRYPTION_KEY="your-super-secret-random-32char-encryption-key-here!"

# -------------------------------------------------------------------------
# 3. AUTHENTICATION & LOGIN CONFIGURATIONS (Google OAuth & NextAuth)
# -------------------------------------------------------------------------
# NextAuth settings:
# - NEXTAUTH_URL: The public domain name of your app managed on Cloudflare (must start with https).
#   For local development, use: http://localhost:3000
NEXTAUTH_URL="https://yourdomain.com"

# - NEXTAUTH_SECRET: A secure random string used to sign NextAuth session cookies.
#   You can generate one using: `openssl rand -base64 32`
NEXTAUTH_SECRET="your-nextauth-session-cookie-signing-secret"

# Google Developer Console Credentials (for "Sign in with Google" OAuth):
# Generate these at: https://console.cloud.google.com/
# In the Authorized Redirect URIs section, add: https://yourdomain.com/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-oauth-client-id-here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret-here"
